
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "pytest",
            "type": "process",
            "command": "${workspaceFolder}/venv/bin/python",
            "args": [
                "-m",
                "pytest",
                "-v"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
